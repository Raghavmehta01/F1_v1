# --- Web (Next.js) ---
# Copy to web/.env.local

# Groq — Llama 3.3 70B for agentic chat (also set on API)
GROQ_API_KEY=

# FastAPI ML + chat service
ML_API_URL=http://127.0.0.1:8000
ML_SHARED_SECRET=change-me-in-production

# OpenF1 — only needed for true live timing (historical/replay works without)
OPENF1_USERNAME=
OPENF1_PASSWORD=

# --- API (FastAPI) ---
# Copy to api/.env

ML_SHARED_SECRET=change-me-in-production
GROQ_API_KEY=
# Prefer llama-3.3-70b-versatile if your Groq account has it
GROQ_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=http://localhost:3000
