# --- Web (Next.js) ---
# Copy to web/.env.local

# Groq — Llama 3.3 70B for agentic chat (also set on API)
GROQ_API_KEY=

# FastAPI ML + chat service
ML_API_URL=http://127.0.0.1:8000
ML_SHARED_SECRET=change-me-in-production

# Extra upstream hostnames for safeFetch (comma-separated), e.g. your Railway/Fly API host
# ALLOWED_UPSTREAM_HOSTS=f1-api.up.railway.app

# Chat abuse limits — visitors get N prompts; owner token = unlimited
CHAT_PROMPTS_LIMIT=5
CHAT_OWNER_TOKEN=change-me-owner-token
# Optional dedicated signing secret for quota cookies (defaults to ML_SHARED_SECRET)
# CHAT_QUOTA_SECRET=

# OpenF1 — only needed for true live timing (historical/replay works without)
OPENF1_USERNAME=
OPENF1_PASSWORD=

# --- API (FastAPI) ---
# Copy to api/.env

ML_SHARED_SECRET=change-me-in-production
GROQ_API_KEY=
# Fast default (real content). Alternatives: openai/gpt-oss-120b, llama-3.3-70b-versatile
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=320
CHAT_CONCURRENCY=24
CORS_ORIGINS=http://localhost:3000
